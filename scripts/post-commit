#!/usr/bin/env bash
# post-commit: auto-extract a learn candidate from the commit just made.
#
# Runs scripts/post_commit_learn.py in the background so the commit never waits.
# That script no-ops silently when Ollama/mq-learn is unavailable and only ever
# writes to the pending inbox (learn_engine/memory/inbox.jsonl), never to the
# curated learn store. Review queued candidates with the learn_inbox MCP tool.
#
# Installed by scripts/install.sh into .git/hooks/post-commit.

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$ROOT/scripts/post_commit_learn.py" ] || exit 0

# Skip while rebasing/cherry-picking to avoid a candidate per replayed commit.
git_dir=$(git rev-parse --git-dir 2>/dev/null)
if [ -n "$git_dir" ] && { [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; }; then
  exit 0
fi

# The uv project (pyproject.toml, uv.lock, .venv) lives in $ROOT/mq-mcp, not in
# $ROOT. A bare `uv run python` from $ROOT finds no project and falls back to an
# interpreter without the project's dependencies, so learn_engine cannot import
# `requests` and every commit is skipped as "ollama unavailable". Point uv at the
# project explicitly; without uv on PATH (GUI clients, agents) use the project
# venv directly before falling back to a bare python3.
APP="$ROOT/mq-mcp"
if command -v uv >/dev/null 2>&1; then
  runner=(uv run --project "$APP" python)
elif [ -x "$APP/.venv/bin/python" ]; then
  runner=("$APP/.venv/bin/python")
else
  runner=(python3)
fi

# learn_engine refuses extraction (without calling the model) unless
# .repo-signal/exports/symbol_index.json is under 24 hours old — see
# docs/LEARN_CONTRACT.md and ADR-007. Nothing else refreshes that export, so
# refresh the primary source here, in the hook, before extracting. This is not
# a fallback: without repo-signal on PATH the export stays as it is and the
# extraction refuses as before.
(
  cd "$ROOT" || exit 0
  trap '' HUP
  {
    if command -v repo-signal >/dev/null 2>&1; then
      repo-signal export . --symbol-index
    fi
    "${runner[@]}" scripts/post_commit_learn.py
  } >/dev/null 2>&1 &
) || true
exit 0
